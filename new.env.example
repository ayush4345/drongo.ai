# ============================================================================
# slate — environment configuration (per layer)
#
# Copy to `.env` at the repo root:   cp new.env.example .env
# `.env` is gitignored, so secrets stay out of git.
#
# MOCK vs REAL
#   • EVM_PRIVATE_KEY unset → OFFLINE MOCK
#   • EVM_PRIVATE_KEY set   → REAL Base. BASE_*_ADDRESS required.
#
# NODE VERSION: consumer server needs Node 22+ (node:sqlite MeterDb);
# provider server needs Node 20+.
# ============================================================================

# ── 1. CHAIN / SETTLEMENT ────────────────────────────────────────────────────
EVM_PRIVATE_KEY=
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
BASE_SLATE_ESCROW_ADDRESS=
BASE_SLATE_AGENT_REGISTRY_ADDRESS=
BASE_SETTLEMENT_VERIFIER_ADDRESS=
# PROVIDER_ADDRESS=0x…
# SETTLEMENT_TOKEN_ID=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# SETTLEMENT_TOKEN_SYMBOL=USDC
# METER_DB_PATH=artifacts/metering.db

# ── 2. PROVIDER SERVER (:4021) ───────────────────────────────────────────────
# PORT=4021
# RATE=0.0001
# X402_PAY_TO=0x…
# X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# X402_NETWORK=base-sepolia
# X402_MAX_AMOUNT=100000000
# MOCK_X402=true
# X402_FACILITATOR_URL=https://x402.org/facilitator

# ── 3. CONSUMER SERVER (:4022) ───────────────────────────────────────────────
# CONSUMER_PORT=4022
# PROVIDER_URL=http://localhost:4021
# CORS_ORIGIN=http://localhost:3000
# ESCROW=0.01
# RATE=0.0001
# X402_PAYMENT_SIGNATURE=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── 4. WEB UI (:3000) ────────────────────────────────────────────────────────
# AGENT_URL=http://localhost:4022
