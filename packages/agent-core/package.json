{
  "name": "@drongo/agent-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "tsc -b && node --test dist/base.test.js dist/x402-client.test.js dist/db.test.js"
  },
  "dependencies": {
    "@drongo/onchain-setup": "workspace:*",
    "@drongo/proving-setup": "workspace:*",
    "viem": "^2.31.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^5.9.2"
  }
}
