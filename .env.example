# Drongo AI — settlement env for the agent demo.
#
# Copy this file to `.env` at the repo root (this is the path the consumer demo
# loads). `.env` is gitignored, so secrets stay out of git.
#
# Without DEPOSITOR_SECRET the demo runs in OFFLINE MOCK mode (no chain calls).
# Set the values below to settle for real on Stellar testnet.

# Funded Stellar testnet account secret (S…) — the CONSUMER's depositor key.
# It funds escrow AND submits the single settlement (the consumer pays for all).
# Fund a fresh keypair instantly via friendbot: https://friendbot.stellar.org
DEPOSITOR_SECRET=

# Deployed Soroban contract IDs (C…) — from your contract deployment.
STELLAR_SLATE_ESCROW_ID=
STELLAR_SLATE_AGENT_REGISTRY_ID=
STELLAR_METERED_VERIFIER_ID=

# ── provider (x402 server, :4021) — advertised in the 402, accepted by consumer ─
# RATE=0.0001                # provider's per-unit rate, whole tokens (source of truth)
# X402_PAY_TO=G...           # provider settlement address (defaults to a demo placeholder)
# X402_ASSET=C...            # SEP-41 token advertised (defaults to testnet USDC)

# ── consumer (chat server, :4022) ─────────────────────────────────────────
# ESCROW=0.01                # consumer-chosen escrow ceiling, whole tokens
# CONSUMER_PORT=4022
# PROVIDER_URL=http://localhost:4021
# CORS_ORIGIN=http://localhost:3000

# ── optional ──────────────────────────────────────────────────────────────
# Settlement token (C…). Defaults to native XLM's Stellar Asset Contract.
# Point at the USDC SAC to settle in USDC instead. Must be whitelisted in escrow.
# SETTLEMENT_TOKEN_ID=
# SETTLEMENT_TOKEN_SYMBOL=XLM
# Use the real OpenAI consumer brain (otherwise a deterministic stub runs).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# RPC overrides (default to Stellar testnet).
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
