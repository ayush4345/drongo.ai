# Drongo AI — settlement env for the agent demo.
#
# Copy this file to `.env` at the repo root (this is the path the consumer demo
# loads). `.env` is gitignored, so secrets stay out of git.
#
# Without EVM_PRIVATE_KEY the demo runs in OFFLINE MOCK mode.

# ── Base ──────────────────────────────────────────────────────────────────
EVM_PRIVATE_KEY=
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532
BASE_SLATE_ESCROW_ADDRESS=
BASE_SLATE_AGENT_REGISTRY_ADDRESS=
BASE_SETTLEMENT_VERIFIER_ADDRESS=
# Optional aliases / overrides
# BASE_METERED_VERIFIER_ADDRESS=
# PROVIDER_ADDRESS=0x…
# SETTLEMENT_TOKEN_ID=0x036CbD53842c5426634e7929541eC2318f3dCF7e  # Base Sepolia USDC
# SETTLEMENT_TOKEN_SYMBOL=USDC

# ── provider (x402 server, :4021) ─────────────────────────────────────────
# RATE=0.0001
# X402_NETWORK=base-sepolia
# X402_PAY_TO=0x…
# X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# MOCK_X402=true
# X402_FACILITATOR_URL=https://x402.org/facilitator

# ── consumer (chat server, :4022) ─────────────────────────────────────────
# ESCROW=0.01
# CONSUMER_PORT=4022
# PROVIDER_URL=http://localhost:4021
# CORS_ORIGIN=http://localhost:3000

# ── optional ──────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
