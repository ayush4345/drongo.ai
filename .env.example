# Drongo AI — settlement env for the agent demo.
#
# Copy this file to `.env` at the repo root. `.env` is gitignored.
#
# DEPOSITOR_SECRET is required: it funds escrow and signs on-chain settlement txs.
# The web dashboard uses Freighter for the x402 channel-open micropayment; escrow
# still uses this server-side key unless you wire full wallet settlement later.

# Funded Stellar testnet account secret (S…) — locks escrow + signs txs.
# Fund via friendbot: https://friendbot.stellar.org
DEPOSITOR_SECRET=

# Deployed Soroban contract IDs (C…) — testnet defaults are baked into the repo.
STELLAR_SLATE_ESCROW_ID=CBQI5U6HJASS7IZFNY2PLZABP2CN5FC6MNJSI2T5DJG6CRZQUYKS3ENM
STELLAR_SLATE_AGENT_REGISTRY_ID=CD6RIA3ZWJOI5RRJBCCPNGELMU3ZIS5XHRZDRMRWOP7EYUEIWI7JV5RR
STELLAR_METERED_VERIFIER_ID=CDBBAWXK53KQO3BHCZLMFWMEEVPKG4I4NLCNYG7GGWUDD6QSECUPRTJR

# Provider account (G…) that receives settlement + x402 open payments.
PROVIDER_PUBLIC=GDTTKEOGUF5HAIMU76UR25RHMZKRTNPFQTQFU3SM7LDFSR2O6YEMI7YR

# ── x402 (provider + wallet channel open) ───────────────────────────────────
# CORS_ORIGIN=http://localhost:3000
# OpenZeppelin facilitator API key (required for x402 verify/settle).
# Generate at https://channels.openzeppelin.com/testnet/gen — the provider auto-fetches
# a testnet key on startup when this is unset.
# X402_FACILITATOR_API_KEY=
# X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# X402_PAY_TO=GDTTKEOGUF5HAIMU76UR25RHMZKRTNPFQTQFU3SM7LDFSR2O6YEMI7YR
# X402_ASSET=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Native XLM SAC on testnet (default — no trustline). For USDC instead:
# X402_ASSET=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# X402_OPEN_PRICE=0.01

# ── optional ──────────────────────────────────────────────────────────────
# Settlement token (C…). Defaults to native XLM SAC. Must be whitelisted in escrow.
# SETTLEMENT_TOKEN_ID=
# SETTLEMENT_TOKEN_SYMBOL=XLM
# Per-call rate and escrow ceiling, in whole tokens (7-decimal stroops under the hood).
# RATE=0.0001
# ESCROW=0.01
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
